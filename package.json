{
  "name": "dova",
  "version": "0.1.0",
  "description": "A gh/glab-style CLI for Azure DevOps: wraps az + git, inferring org/project/repo/team from the current repo instead of flags.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dova": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "execa": "^9.5.2",
    "ini": "^5.0.0",
    "jq-wasm": "^3.0.0-jq-1.8.2",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/ini": "^4.1.1",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
